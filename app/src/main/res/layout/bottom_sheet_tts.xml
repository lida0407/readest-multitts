<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_drag_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Voice &amp; playback · 语音设置"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMultiTtsGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_green_soft"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:text="★ MultiTTS Engine"
                android:textColor="@color/green"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Language Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.08"
            android:text="LANGUAGE · 语言"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerLanguage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_spinner_light"
            android:popupBackground="@color/surface" />

        <!-- Engine Selector Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="SPEECH ENGINE · 引擎"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTtsEngine"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_spinner_light"
            android:popupBackground="@color/surface" />

        <!-- Voice Selector Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="VOICE · 发音人"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnVoicePicker"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_spinner_light"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Default voice"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- Speed & Pitch side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.06"
                        android:text="SPEED 语速"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSheetRateVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0x"
                        android:textColor="@color/accent"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSpeechRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.1"
                    android:value="1.0"
                    android:valueFrom="0.5"
                    android:valueTo="3.0"
                    app:thumbColor="@color/accent"
                    app:trackColorActive="@color/accent"
                    app:trackColorInactive="@color/track"
                    app:trackHeight="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.06"
                        android:text="PITCH 音调"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSheetPitchVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0"
                        android:textColor="@color/accent"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSpeechPitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.1"
                    android:value="1.0"
                    android:valueFrom="0.5"
                    android:valueTo="2.0"
                    app:thumbColor="@color/accent"
                    app:trackColorActive="@color/accent"
                    app:trackColorInactive="@color/track"
                    app:trackHeight="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section: Local Audio Pre-generation & Energy Saving -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_cache_card_green"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ Energy-saving local cache · 本地缓存"
                    android:textColor="@color/green_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCacheStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 KB cached"
                    android:textColor="@color/green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pre-synthesizes speech to local audio so playback works offline with 0% TTS CPU."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Cache Scope Radio Selection -->
            <RadioGroup
                android:id="@+id/rgCacheScope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCacheChapter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/green"
                    android:checked="true"
                    android:text="Current chapter 本章"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbCacheBook"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/green"
                    android:text="Entire book 全书"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- Unfinished job from a previous session -->
            <TextView
                android:id="@+id/tvResumeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_green_soft"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp"
                android:text=""
                android:textColor="@color/green_text"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <!-- Keep the screen awake so a long cache job isn't cut short by the lock screen -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchKeepAwake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="Keep screen on while caching 缓存时不锁屏"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <!-- Pre-generate Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreCacheChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/green"
                    android:text="Start pre-cache · 开始缓存"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestartCache"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Start over 重来"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/surface_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPauseCache"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Pause 暂停"
                    android:textAllCaps="false"
                    android:textColor="@color/green"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/green_line" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopCache"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Stop 停止"
                    android:textAllCaps="false"
                    android:textColor="@color/danger"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/red_line" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCache"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Manage 管理"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/surface_border" />
            </LinearLayout>

            <!-- Pre-generation Progress Bar -->
            <ProgressBar
                android:id="@+id/pbPrecacheProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_thin_green"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPrecacheStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Synthesizing…"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sleep Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="SLEEP TIMER · 定时关闭"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerSleepTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spinner_light"
                android:popupBackground="@color/surface" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
