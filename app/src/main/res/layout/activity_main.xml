<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rdBg">

    <!-- Reader top toolbar (hidden on library screen) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/rdBg"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="10dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back to Library"
                    android:src="@android:drawable/ic_menu_revert"
                    android:visibility="gone"
                    app:tint="?attr/rdTextSecondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Readest++"
                        android:textAppearance="?attr/rdTitleAppearance" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="MultiTTS 离线朗读"
                        android:textAppearance="?attr/rdSubtitleAppearance" />
                </LinearLayout>

                <!-- MultiTTS Engine Status Indicator -->
                <TextView
                    android:id="@+id/chipMultiTtsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/rdChipBgSuccess"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="3dp"
                    android:text="MultiTTS ✓"
                    android:textAppearance="?attr/rdChipAppearance"
                    android:textColor="?attr/rdOnSuccessChip" />

                <!-- Table of contents / chapter jump -->
                <ImageButton
                    android:id="@+id/btnContents"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Contents and bookmarks"
                    android:src="@drawable/ic_contents_list"
                    android:visibility="gone"
                    app:tint="?attr/rdTextSecondary" />

                <!-- Bookmark the current position -->
                <ImageButton
                    android:id="@+id/btnBookmark"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Bookmark this spot"
                    android:src="@drawable/ic_bookmark_outline"
                    android:visibility="gone"
                    app:tint="?attr/rdTextSecondary" />

                <!-- Reader Theme / Display Settings Button -->
                <TextView
                    android:id="@+id/btnReaderSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Themes &amp; Fonts"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Aa"
                    android:textAppearance="?attr/rdTitleAppearance"
                    android:textColor="?attr/rdTextSecondary"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnTtsMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="TTS Options"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="?attr/rdTextSecondary" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_settings_gear"
                    app:tint="?attr/rdTextSecondary" />

                <ImageButton
                    android:id="@+id/btnImportBook"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Import Book"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="?attr/rdAccent" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Library UI container -->
        <LinearLayout
            android:id="@+id/libraryContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Hero header: identity, streak, and the level bar -->
            <LinearLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/rdHeaderBg"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHeroLogo"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/rdLogoBg"
                        android:gravity="center"
                        android:text="R"
                        android:textAppearance="?attr/rdDisplayAppearance"
                        android:textColor="?attr/rdOnAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Readest++"
                            android:textAppearance="?attr/rdDisplayAppearance"
                            android:textColor="?attr/rdOnHeaderCard" />

                        <TextView
                            android:id="@+id/tvHeroStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="MultiTTS 离线朗读 · Offline audio reading"
                            android:textAppearance="?attr/rdSubtitleAppearance" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnHeroMultiTts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/rdChipBgSuccess"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        android:text="MultiTTS ✓"
                        android:textAppearance="?attr/rdChipAppearance"
                        android:textColor="?attr/rdOnSuccessChip" />
                </LinearLayout>

                <!-- Level bar. Gone in Classic, which has no levels. -->
                <LinearLayout
                    android:id="@+id/xpRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvXpLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="XP"
                        android:textAppearance="?attr/rdSubtitleAppearance"
                        android:textColor="?attr/rdInfo" />

                    <ProgressBar
                        android:id="@+id/pbXp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="680"
                        android:progressDrawable="?attr/rdXpProgressDrawable" />

                    <TextView
                        android:id="@+id/tvXpValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="6 820/10 000"
                        android:textAppearance="?attr/rdSubtitleAppearance"
                        android:textColor="?attr/rdInfo" />
                </LinearLayout>
            </LinearLayout>

            <!-- Capability chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCachedPlayback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/rdChipBg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:text="⚡ Offline audio · 离线音频"
                    android:textAppearance="?attr/rdChipAppearance"
                    android:textColor="?attr/rdOnChip" />

                <TextView
                    android:id="@+id/chipFormats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/rdChipBg"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:text="TXT · EPUB · MOBI · PDF"
                    android:textAppearance="?attr/rdChipAppearance"
                    android:textColor="?attr/rdOnChip" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnOpenSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/rdChipBg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:text="⚙ Settings · 设置"
                    android:textAppearance="?attr/rdChipAppearance"
                    android:textColor="?attr/rdOnChip" />

                <TextView
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/rdChipBgMuted"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:maxLines="1"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:text="v1.18.0 · tap to check for update"
                    android:textAppearance="?attr/rdChipAppearance"
                    android:textColor="?attr/rdTextSecondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnMainImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/rdButtonPrimaryBg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="＋ Import a book · 导入书籍"
                android:textAppearance="?attr/rdHeadingAppearance"
                android:textColor="?attr/rdOnAccent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvShelfLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MY SHELF 我的书架"
                    android:textAppearance="?attr/rdEyebrowAppearance" />

                <!-- Shelf order: last read / title / recently added -->
                <TextView
                    android:id="@+id/btnSortBooks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/rdChipBgMuted"
                    android:clickable="true"
                    android:contentDescription="Change shelf order"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="11dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="4dp"
                    android:text="Last read 最近阅读 ▾"
                    android:textAppearance="?attr/rdChipAppearance"
                    android:textColor="?attr/rdTextSecondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmptyShelf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="书架还是空的\nImport a TXT / EPUB / MOBI / PDF to start reading"
                android:textAppearance="?attr/rdBodyAppearance"
                android:textColor="?attr/rdTextTertiary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentBooks"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />
        </LinearLayout>

        <!-- Reader WebView container -->
        <WebView
            android:id="@+id/readerWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Shown while a book is being parsed on a background thread -->
        <LinearLayout
            android:id="@+id/openingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/rdBg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminateTint="?attr/rdAccent" />

            <TextView
                android:id="@+id/tvOpeningLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Opening…"
                android:textAppearance="?attr/rdBodyAppearance"
                android:textColor="?attr/rdTextSecondary" />
        </LinearLayout>

        <!-- Floating TTS Mini Player Bar -->
        <LinearLayout
            android:id="@+id/ttsMiniPlayerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="?attr/rdPanelBg"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <!-- Spoken text sentence preview & cache source tag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentSentence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ready to read aloud…"
                    android:textAppearance="?attr/rdSubtitleAppearance" />

                <TextView
                    android:id="@+id/tvAudioSourceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/rdChipBgSuccess"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="⚡ Cached · 0% CPU"
                    android:textAppearance="?attr/rdChipAppearance"
                    android:textColor="?attr/rdOnSuccessChip" />
            </LinearLayout>

            <!-- Chapter scrubber: drag to jump to any sentence.
                 Secondary track shows how much of the chapter is cached. -->
            <SeekBar
                android:id="@+id/sliderTtsProgress"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:maxHeight="16dp"
                android:minHeight="16dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:progressDrawable="?attr/rdSeekbarDrawable"
                android:splitTrack="false"
                android:thumb="?attr/rdSeekbarThumb"
                android:thumbOffset="0dp" />

            <TextView
                android:id="@+id/tvScrubberLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:layout_marginBottom="2dp"
                android:text=""
                android:textAppearance="?attr/rdSubtitleAppearance"
                android:textColor="?attr/rdTextTertiary" />

            <!-- Controls row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTtsSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/rdChipBgMuted"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:text="1.0x"
                    android:textAppearance="?attr/rdChipAppearance"
                    android:textColor="?attr/rdTextPrimary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnTtsPrev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Previous Sentence"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="?attr/rdTextSecondary" />

                <ImageButton
                    android:id="@+id/fabTtsPlayPause"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/rdButtonPrimaryBg"
                    android:contentDescription="Play/Pause"
                    android:scaleType="center"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="?attr/rdOnAccent" />

                <ImageButton
                    android:id="@+id/btnTtsNext"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Next Sentence"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="?attr/rdTextSecondary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Sentences narrated this session. Replaced by the expand
                     button in Classic, which has no combo to show. -->
                <TextView
                    android:id="@+id/tvCombo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text=""
                    android:textAppearance="?attr/rdChipAppearance"
                    android:textColor="?attr/rdAccent"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnTtsPanelExpand"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Expand TTS settings"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="?attr/rdTextTertiary" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
