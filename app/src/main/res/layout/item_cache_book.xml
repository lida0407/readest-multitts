<?xml version="1.0" encoding="utf-8"?>
<!-- A themed background rather than MaterialCardView: the card view paints its
     own surface overlay, which washed every card coral in Cozy, and it cannot
     draw the hard keyline Pixel and Cozy cards are made of. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="?attr/rdCardBg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvCacheBookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Book title"
            android:textColor="?attr/rdTextPrimary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCacheBookMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="0 MB · 0 clips"
            android:textColor="?attr/rdTextSecondary"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportBook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="?attr/rdSuccess"
                android:text="Audio 音频"
                android:textAllCaps="false"
                android:textColor="?attr/rdOnAccent"
                android:textSize="12sp"
                app:cornerRadius="22dp" />

            <TextView
                android:id="@+id/btnBundleBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="?attr/rdChipBg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="11dp"
                android:paddingTop="5dp"
                android:paddingEnd="11dp"
                android:paddingBottom="5dp"
                android:text="Book + audio 整本"
                android:textAppearance="?attr/rdChipAppearance"
                android:textColor="?attr/rdOnChip" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteBookCache"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete 删除"
                android:textAllCaps="false"
                android:textColor="?attr/rdDanger"
                android:textSize="12sp"
                app:cornerRadius="22dp"
                app:strokeColor="?attr/rdDanger" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
