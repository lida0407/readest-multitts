<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rdPanel"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="8dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="?attr/rdDragHandleBg" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Offline audio · 离线音频"
        android:textColor="?attr/rdTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCacheSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 B cached"
        android:textColor="?attr/rdTextSecondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvCacheEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="还没有离线音频\nCache a chapter or book from Voice &amp; playback settings"
        android:textColor="?attr/rdTextTertiary"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCacheBooks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvCacheStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text=""
        android:textColor="?attr/rdSuccess"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/pbCacheExport"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progressDrawable="?attr/rdCacheProgressDrawable"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelExport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel export 取消"
            android:textAllCaps="false"
            android:textColor="?attr/rdTextSecondary"
            android:textSize="12sp"
            android:visibility="gone"
            app:cornerRadius="22dp"
            app:strokeColor="?attr/rdOutlineMuted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearAllCache"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete all 全部删除"
            android:textAllCaps="false"
            android:textColor="?attr/rdDanger"
            android:textSize="12sp"
            app:cornerRadius="22dp"
            app:strokeColor="?attr/rdDanger" />
    </LinearLayout>
</LinearLayout>
