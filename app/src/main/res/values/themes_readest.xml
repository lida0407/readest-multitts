<?xml version="1.0" encoding="utf-8"?>
<!--
  The three app themes.

  Each supplies the complete rd* set declared in attrs_readest.xml plus the
  Material 3 attributes its widgets need, so switching theme is one setTheme()
  call and a recreate() — no view walks that go stale the moment a layout is
  edited.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Everything the three share: window flags, sheet plumbing, base parent. -->
    <style name="Theme.Readest.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="bottomSheetDialogTheme">@style/Theme.Readest.BottomSheet</item>
        <item name="android:windowBackground">?attr/rdBg</item>
        <item name="android:colorBackground">?attr/rdBg</item>
        <item name="android:statusBarColor">?attr/rdBg</item>
        <item name="android:navigationBarColor">?attr/rdBg</item>
    </style>

    <style name="Theme.Readest.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Readest.BottomSheet</item>
    </style>

    <style name="Widget.Readest.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/rdPanel</item>
        <item name="shapeAppearance">?attr/shapeAppearanceLargeComponent</item>
    </style>

    <!-- ══════════════════════ Classic ══════════════════════ -->
    <style name="Theme.Readest.Classic" parent="Theme.Readest.Base">
        <item name="rdBg">@color/bg_app</item>
        <item name="rdPanel">@color/surface</item>
        <item name="rdPanelSunk">@color/track</item>
        <item name="rdShadow">@color/surface_border</item>
        <item name="rdHeaderCard">@color/accent_tint</item>
        <item name="rdOnHeaderCard">@color/text_primary</item>

        <item name="rdOutline">@color/surface_border</item>
        <item name="rdOutlineMuted">@color/surface_border</item>
        <item name="rdDivider">@color/surface_border</item>

        <item name="rdTextPrimary">@color/text_primary</item>
        <item name="rdTextSecondary">@color/text_secondary</item>
        <item name="rdTextTertiary">@color/text_tertiary</item>

        <item name="rdAccent">@color/accent</item>
        <item name="rdOnAccent">#FFFFFF</item>
        <item name="rdOnChip">@color/accent_dark</item>
        <item name="rdOnSuccessChip">@color/green</item>
        <item name="rdXp">@color/accent</item>
        <item name="rdInfo">@color/accent_dark</item>
        <item name="rdInfoSoft">@color/accent_soft</item>
        <item name="rdSuccess">@color/green</item>
        <item name="rdSuccessBright">@color/green</item>
        <item name="rdCachedTrack">@color/green_border</item>
        <item name="rdDanger">@color/danger</item>
        <item name="rdBadgeBg">@color/badge_epub</item>

        <item name="rdBadgeEpub">@color/badge_epub</item>
        <item name="rdBadgeTxt">@color/badge_txt</item>
        <item name="rdBadgePdf">@color/badge_pdf</item>
        <item name="rdBadgeMobi">@color/badge_mobi</item>

        <item name="rdReaderPage">#FAFAFA</item>
        <item name="rdReaderInk">#18181B</item>
        <item name="rdSentenceHl">@color/accent_soft</item>
        <item name="rdWordHl">@color/green_soft</item>

        <item name="rdPanelBg">@drawable/rd_classic_panel</item>
        <item name="rdHeaderBg">@drawable/rd_classic_panel</item>
        <item name="rdCardBg">@drawable/rd_classic_card</item>
        <item name="rdSunkBg">@drawable/rd_classic_sunk</item>
        <item name="rdSheetBg">@drawable/rd_classic_panel</item>
        <item name="rdChipBg">@drawable/rd_classic_chip</item>
        <item name="rdChipBgSuccess">@drawable/rd_classic_chip_success</item>
        <item name="rdChipBgMuted">@drawable/rd_classic_chip_muted</item>
        <item name="rdButtonPrimaryBg">@drawable/rd_classic_button</item>
        <item name="rdIconTileBg">@drawable/rd_classic_tile</item>
        <item name="rdLogoBg">@drawable/rd_classic_logo</item>
        <item name="rdDragHandleBg">@drawable/rd_classic_handle</item>
        <item name="rdProgressDrawable">@drawable/rd_classic_progress</item>
        <item name="rdCacheProgressDrawable">@drawable/rd_classic_cache_progress</item>
        <item name="rdXpProgressDrawable">@drawable/rd_classic_xp</item>
        <item name="rdSeekbarDrawable">@drawable/rd_classic_seekbar</item>
        <item name="rdSeekbarThumb">@drawable/rd_classic_thumb</item>
        <item name="rdBadgeBgShape">@drawable/rd_classic_badge</item>

        <item name="rdDisplayAppearance">@style/TextAppearance.Classic.Display</item>
        <item name="rdHeadingAppearance">@style/TextAppearance.Classic.Heading</item>
        <item name="rdEyebrowAppearance">@style/TextAppearance.Classic.Eyebrow</item>
        <item name="rdTitleAppearance">@style/TextAppearance.Classic.Title</item>
        <item name="rdBodyAppearance">@style/TextAppearance.Classic.Body</item>
        <item name="rdSubtitleAppearance">@style/TextAppearance.Classic.Subtitle</item>
        <item name="rdValueAppearance">@style/TextAppearance.Classic.Value</item>
        <item name="rdChipAppearance">@style/TextAppearance.Classic.Chip</item>
        <item name="android:textViewStyle">@style/Widget.Readest.TextView.Classic</item>
        <item name="materialButtonStyle">@style/Widget.Readest.Button.Classic</item>
        <item name="rdFontHeading">@null</item>
        <item name="rdFontBody">@null</item>

        <!-- Material 3 -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent_dark</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/track</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/surface_border</item>
        <item name="colorError">@color/danger</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

