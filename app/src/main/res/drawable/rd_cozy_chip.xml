<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/rdInfoSoft" />
            <stroke android:width="2.5dp" android:color="?attr/rdOutline" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/rdPanel" />
            <stroke android:width="2.5dp" android:color="?attr/rdOutline" />
            <corners android:radius="99dp" />
        </shape>
    </item>
</selector>
