<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/rdAccent" />
            <stroke android:width="2dp" android:color="?attr/rdOutline" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/rdShadow" />
            <stroke android:width="2dp" android:color="?attr/rdOutline" />
        </shape>
    </item>
</selector>
