<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/rdInfoSoft" />
            <stroke android:width="1dp" android:color="?attr/rdAccent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/rdPanelSunk" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
