<?xml version="1.0" encoding="utf-8"?>
<!-- The face moves into the shadow rather than the whole button moving, so the
     bounds never change and nothing around it reflows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape><solid android:color="?attr/rdShadow" /></shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <solid android:color="?attr/rdAccent" />
            <stroke android:width="4dp" android:color="?attr/rdOutline" />
        </shape>
    </item>
</layer-list>
