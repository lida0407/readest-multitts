<?xml version="1.0" encoding="utf-8"?>
<!-- Hard 4dp offset shadow, drawn as a second rect rather than elevation:
     elevation renders a soft blur, which reads as wrong at this scale. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape>
            <solid android:color="?attr/rdShadow" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape>
            <solid android:color="?attr/rdPanel" />
            <stroke android:width="4dp" android:color="?attr/rdOutline" />
        </shape>
    </item>
</layer-list>
